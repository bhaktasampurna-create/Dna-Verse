# GEMINI_API_KEY: Optional server-side API key if needed for future extensions.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAILS: Comma-separated list of Firebase Auth user emails granted administrator role on the server.
# Never expose admin credentials in client code or add a public admin registration route.
ADMIN_EMAILS=

# Optional Supabase Configuration (when deploying with external Supabase PostgreSQL & Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
